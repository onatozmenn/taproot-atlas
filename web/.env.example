# AI narrator. OpenAI GPT-6 Luna by default (Responses API).
# Zen also works: AI_BASE_URL=https://opencode.ai/zen/v1,
# AI_MODEL=gpt-6-luna, same Zen key.
# Keys go in the Vercel dashboard, never here. Empty key = audited template.
AI_BASE_URL=https://api.openai.com/v1
AI_API_MODE=responses
AI_MODEL=gpt-6-luna
AI_API_KEY=

# JEV second audit layer via Zen (jev-1.13-free is free; same Zen key).
# Direct TypeSafe also works: JEV_BASE_URL=https://api.typesafe.ai, JEV_MODEL=jev-latest.
JEV_BASE_URL=https://opencode.ai/zen
JEV_MODEL=jev-1.13-free
JEV_API_KEY=

# Protomaps vector basemap (MapLibre GL). First configured wins; empty = OSM raster.
# Setup (free for non-commercial use):
#   1. Sign up at https://protomaps.com/account and issue an API key.
#   2. In the account portal, allowlist your domains per key (CORS): your
#      Vercel production domain + preview domains (e.g. *.vercel.app).
#      Localhost is exempt and works without allowlisting.
# Docs: https://protomaps.com/api (TileJSON pattern used by web/src/components/RealMap.tsx)
VITE_PROTOMAPS_API_KEY=
# Alternative: self-hosted .pmtiles extract (pmtiles:// protocol, same-origin
# or CORS-enabled hosting required — build.protomaps.com has no CORS headers).
VITE_PROTOMAPS_TILES_URL=
