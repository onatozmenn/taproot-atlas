# AI narrator (OpenAI-compatible chat-completions). Your key goes in the
# Vercel dashboard (Project → Settings → Environment Variables), never here.
# Leave AI_API_KEY empty to serve the audited template narrator.
# Point AI_BASE_URL at OpenAI — or at opencode Zen if it exposes an
# OpenAI-compatible endpoint + key for your plan — and set AI_MODEL to match.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-luna-6
AI_API_KEY=

# JEV second audit layer (TypeSafe System One decisions over the narrative).
# Get a key at typesafe.ai; also honored: Vercel AI Gateway (AI_GATEWAY_API_KEY
# with model typesafe-ai/jev) or OpenRouter (OPENROUTER_API_KEY with model
# typesafe/jev-1.13) — set JEV_BASE_URL/JEV_MODEL only if you use them.
# Leave JEV_API_KEY empty to run on the deterministic audit alone.
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_API_KEY=
