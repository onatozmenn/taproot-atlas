# AI narrator. OpenAI GPT-6 Luna by default (Responses API).
# Zen also works: AI_BASE_URL=https://opencode.ai/zen/v1,
# AI_MODEL=gpt-6-luna, same Zen key.
# Keys go in the Vercel dashboard, never here. Empty key = audited template.
AI_BASE_URL=https://api.openai.com/v1
AI_API_MODE=responses
AI_MODEL=gpt-6-luna
AI_API_KEY=

# JEV second audit layer via Zen (jev-1.13-free is free; same Zen key).
# Direct TypeSafe also works: JEV_BASE_URL=https://api.typesafe.ai, JEV_MODEL=jev-latest.
JEV_BASE_URL=https://opencode.ai/zen
JEV_MODEL=jev-1.13-free
JEV_API_KEY=

# Protomaps vector basemap (MapLibre GL). First configured wins; empty = OSM raster.
# Get a free key at https://protomaps.com (TileJSON), or host your own .pmtiles extract.
VITE_PROTOMAPS_API_KEY=
VITE_PROTOMAPS_TILES_URL=
