# AI narrator. Your Zen key goes in the Vercel dashboard
# (Project → Settings → Environment Variables), never here.
# Same key can serve JEV below. OpenAI also works: set AI_BASE_URL to
# https://api.openai.com/v1, AI_API_MODE to chat-completions, and AI_MODEL
# to your OpenAI model id.
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_MODE=responses
AI_MODEL=gpt-6-luna
AI_API_KEY=

# JEV second audit layer (TypeSafe System One via Zen; jev-1.13-free is free).
# JEV_API_KEY may be the same Zen key. Direct TypeSafe also works:
# JEV_BASE_URL=https://api.typesafe.ai with JEV_MODEL=jev-latest.
JEV_BASE_URL=https://opencode.ai/zen
JEV_MODEL=jev-1.13-free
JEV_API_KEY=
