{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "functions": {
    "api/ask.ts": {
      "includeFiles": "data/{national,global}/**",
      "maxDuration": 60
    },
    "api/triage.ts": {
      "includeFiles": "data/national/triage.json.gz",
      "maxDuration": 15
    },
    "api/feedback.ts": {
      "maxDuration": 10
    }
  }
}
